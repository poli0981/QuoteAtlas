{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holiday-override.schema.json",
  "title": "QuoteAtlas per-country holiday override",
  "type": "object",
  "additionalProperties": false,
  "required": ["country"],
  "properties": {
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "add": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "rule"],
        "properties": {
          "tag": { "type": "string" },
          "rule": {
            "type": "string",
            "description": "M-D | lunar:M-D | easter[±N] | nth:M-W-N | last:M-W | term:NAME[±N] — see src/features/holidays/rules.ts",
            "pattern": "^(?:[0-9]{1,2}-[0-9]{1,2}|lunar:[0-9]{1,2}-[0-9]{1,2}|easter(?:[+-][0-9]{1,3})?|nth:[0-9]{1,2}-[0-6]-[1-5]|last:[0-9]{1,2}-[0-6]|term:[a-z]+(?:[+-][0-9]{1,3})?)$"
          },
          "days": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "remove": { "type": "array", "items": { "type": "string" } }
  }
}
